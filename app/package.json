{
  "name": "vibechem-app",
  "productName": "VibeChem",
  "version": "0.0.0",
  "private": true,
  "description": "VibeChem desktop app (Electron + React)",
  "homepage": "https://github.com/PengooNg/VibeChem",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:cdp": "electron-vite dev --remoteDebuggingPort 9339",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "gen:api": "uv run python ../scripts/export_openapi.py out/openapi.json && openapi-typescript out/openapi.json -o renderer/src/api/schema.d.ts && prettier --write renderer/src/api/schema.d.ts",
    "e2e": "electron-vite build && playwright test",
    "dist": "electron-vite build && electron-builder --publish never",
    "postinstall": "install-electron"
  },
  "packageManager": "pnpm@10.34.9+sha512.f49b5a8ea0fdedb44bb3c0c1d6575092a53c2950d95b7ad15df11f17974877a2de3a01c07e934e9b28ce716e51c09a94962c7306d09be2e1e4b18a8c8762fd32",
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/noto-sans-jp": "5.3.1",
    "@playwright/cli": "0.1.23",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/react-query": "5.107.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "@xyflow/react": "12.12.1",
    "apache-arrow": "21.2.0",
    "clsx": "2.1.1",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "electron-vite": "5.0.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "i18next": "26.7.2",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-i18next": "17.1.13",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "uplot": "1.6.32",
    "vite": "7.3.8",
    "vitest": "4.1.12"
  }
}
