# Secrets and local settings (never committed)
.env
.env.*
.claude/settings.local.json
# Agent worktrees
.claude/worktrees/
# Full test/check logs from the quiet-test hook
.cache/
# pengoo sources (Quan's private code, read for ports only; the dev repo is public)
pengoo/

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
/build/
packages/*/build/
dist/
.pytest_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/

# Node / Electron
node_modules/
out/
# Playwright CLI sessions, snapshots and screenshots (attach to PRs, never commit)
.playwright-cli/
# Playwright Test results and HTML report (`pnpm --dir app e2e`)
test-results/
playwright-report/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

