{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git switch *)",
      "Bash(git checkout *)",
      "Bash(git branch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git rev-parse *)",
      "Bash(git merge-base *)",
      "Bash(git bisect *)",
      "Bash(git restore *)",
      "Bash(gh pr *)",
      "Bash(gh issue *)",
      "Bash(gh run *)",
      "Bash(gh label *)",
      "Bash(gh auth status *)",
      "Bash(uv *)",
      "Bash(pnpm *)",
      "Bash(corepack *)",
      "WebSearch",
      "WebFetch",
      "mcp__context7__*",
      "Bash(pnpm --dir app exec playwright-cli *)",
      "Bash(playwright-cli *)",
      "Bash(npx playwright-cli *)",
      "Bash(npx playwright install *)"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(git reset *)",
      "Bash(git clean *)",
      "Bash(git rebase *)",
      "Bash(git stash *)",
      "Bash(git merge *)",
      "Bash(gh api *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push origin main *)",
      "Bash(git push origin HEAD:main *)",
      "Bash(git push origin phase-*)",
      "Bash(gh pr merge *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo edit *)",
      "Bash(gh ruleset *)",
      "Bash(gh secret *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(npx impeccable live *)",
      "Bash(npx impeccable install *)",
      "Bash(npx impeccable telemetry on *)",
      "Bash(headroom *)"
    ]
  }
}
