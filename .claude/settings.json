{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "DO_NOT_TRACK": "1"
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git switch *)",
      "Bash(git checkout *)",
      "Bash(git branch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git rev-parse *)",
      "Bash(git merge-base *)",
      "Bash(git bisect *)",
      "Bash(git restore *)",
      "Bash(gh pr *)",
      "Bash(gh issue *)",
      "Bash(gh run *)",
      "Bash(gh label *)",
      "Bash(gh auth status *)",
      "Bash(uv *)",
      "Bash(pnpm *)",
      "Bash(corepack *)",
      "WebSearch",
      "WebFetch",
      "mcp__context7__*",
      "Bash(pnpm --dir app exec playwright-cli *)",
      "Bash(playwright-cli *)",
      "Bash(npx playwright-cli *)",
      "Bash(npx playwright install *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push origin main *)",
      "Bash(git push origin HEAD:main *)",
      "Bash(git push origin phase-*)",
      "Bash(git reset --hard *)",
      "Bash(git rebase *)",
      "Bash(git filter-branch *)",
      "Bash(gh pr merge *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo edit *)",
      "Bash(gh secret *)",
      "Bash(gh auth token *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.claude/settings.json)",
      "Edit(./.claude/settings.local.json)",
      "Edit(./scripts/permission_gate.py)",
      "mcp__claude_ai_Gmail",
      "mcp__claude_ai_Google_Calendar",
      "mcp__claude_ai_Google_Drive",
      "mcp__claude_ai_github",
      "Bash(npx impeccable live *)",
      "Bash(npx impeccable install *)",
      "Bash(npx impeccable telemetry on *)",
      "Bash(headroom *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/scripts/permission_gate.py\"",
            "timeout": 20,
            "onFailure": "block"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true
  }
}
